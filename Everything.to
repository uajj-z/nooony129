delete php 
<?php
$index = $_POST['index'];
$xml = new DOMDocument();
$xml->load("trainees.xml");
$trainees = $xml->getElementsByTagName("trainee");
  $trainee = $trainees->item($index);
    $trainee->parentNode->removeChild($trainee);
$xml-> Save('trainees.xml');
?> 


insert php 
<?php
$Name  = $_POST['Name'];
$Email = $_POST['Email'];
$Major = $_POST['Major'];

$xml = new DOMDocument();

// Check if XML loads correctly
if (!$xml->load('trainees.xml')) {
    die('Error loading XML file');
}

$root = $xml->getElementsByTagName('trainees')->item(0);

if ($root === null) {
    die('Root <trainees> not found');
}

// Create trainee
$trainee = $xml->createElement('trainee');
$trainee->appendChild($xml->createElement('Name', $Name));
$trainee->appendChild($xml->createElement('Email', $Email));
$trainee->appendChild($xml->createElement('Major', $Major));

// Append and save
$root->appendChild($trainee);
$xml->save('trainess.xml');
?>
